# syntax=docker/dockerfile:1.7
ARG VLLM_BASE_IMAGE=vllm/vllm-openai:cosmos3
FROM ${VLLM_BASE_IMAGE}

ARG BENCHMARK_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${BENCHMARK_GIT_SHA}
LABEL org.opencontainers.image.title="Cosmos3 RF100VL benchmark"

USER root
WORKDIR /benchmark

COPY requirements-cosmos.txt requirements-cosmos-runpod.txt ./
# The RF100VL downloader currently pins OpenCV below vLLM's requirement. Keep
# all evaluator/downloader dependencies isolated so the release-tested serving
# environment remains byte-for-byte untouched.
RUN python3 -m venv /opt/cosmos-eval && \
    /opt/cosmos-eval/bin/python -m pip install --no-cache-dir \
        -r requirements-cosmos-runpod.txt

COPY . .
RUN chmod +x infra/cosmos_runpod_entrypoint.sh && \
    python3 -c \
        "import importlib.metadata as m; from packaging.version import Version; assert Version(m.version('opencv-python-headless')) >= Version('4.13.0'); print('vllm=' + m.version('vllm'))" && \
    /opt/cosmos-eval/bin/python -m unittest -v \
        test_evaluate_cosmos.py \
        test_cosmos_sharding.py \
        test_preflight_cosmos.py \
        test_runpod_cosmos.py

ENV BENCHMARK_GIT_SHA=${BENCHMARK_GIT_SHA}
ENV HF_HOME=/workspace/huggingface
ENV HF_HUB_CACHE=/workspace/huggingface/hub
ENV HF_XET_HIGH_PERFORMANCE=1
ENV COSMOS_WORK_DIR=/workspace/cosmos-runpod-work
ENV RF100VL_DIR=/workspace/rf100-vl
ENV COSMOS_EVAL_PYTHON=/opt/cosmos-eval/bin/python

# Clear the upstream serving entrypoint: this image starts the server and the
# evaluator together so their exact configuration is captured in one job.
ENTRYPOINT []
CMD ["bash", "infra/cosmos_runpod_entrypoint.sh"]
